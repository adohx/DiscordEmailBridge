DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional: restricts the bridge to this guild in addition to the channel above.
DISCORD_GUILD_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Comma-separated list of mailboxes that receive Discord messages.
# Single recipient is fine too: TARGET_EMAILS=alice@example.com
TARGET_EMAILS=
# Comma-separated list of mailboxes allowed to reply and be forwarded back to
# Discord, paired POSITIONALLY with ALLOWED_EMAIL_SENDER_NAMES below -- the
# Nth email uses the Nth name. Single sender is fine too.
ALLOWED_EMAIL_SENDERS=
# Display name shown in Discord for each sender above, e.g. with
# ALLOWED_EMAIL_SENDERS=alice@example.com,bob@example.com and
# ALLOWED_EMAIL_SENDER_NAMES=Alice,Bob, a reply from Bob shows as
# "📧 Email reply from Bob:". Not parsed from the email -- set explicitly.
ALLOWED_EMAIL_SENDER_NAMES=

EMAIL_POLL_INTERVAL_SECONDS=60
STATE_FILE=state.json

# Domain used to build synthetic Message-IDs for Discord->Email messages.
# Looks like an email domain but doesn't need to be a real mailbox.
EMAIL_MESSAGE_ID_DOMAIN=bridge.local

# Whether delete-notification emails include the deleted message's original content.
INCLUDE_DELETED_CONTENT=true
